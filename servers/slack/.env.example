# Slack bot token and team ID
# Create a Slack app at https://api.slack.com/apps and install it to your workspace.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_TEAM_ID=T12345678

# Optional: comma-separated channel IDs to restrict access to
SLACK_CHANNEL_IDS=C1234567890,C9876543210

# Optional: require 'X-API-Key' header for incoming requests
SERVER_API_KEY=your-secret-key
